# Copy this file to .env and fill in real values. Never commit .env.

ROBINHOOD_USERNAME=you@example.com
ROBINHOOD_PASSWORD=changeme

# Optional: only needed if your Robinhood account uses an authenticator app
# (TOTP) for MFA. Leave blank if you approve login via push notification
# instead - in that case the first login will prompt you on your phone.
ROBINHOOD_TOTP_SECRET=

# Float data (src/float_data.py). Set whichever matches config.yaml's
# float_provider (fmp recommended - free key at financialmodelingprep.com).
# Set both if float_cross_check is enabled.
FMP_API_KEY=
ALPHA_VANTAGE_API_KEY=
